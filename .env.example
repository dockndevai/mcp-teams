# --- Authentication ---------------------------------------------------------
# Auth is chosen automatically: interactive browser sign-in unless a secret or a
# static token is present. Override explicitly with TEAMS_AUTH if you want.
#   TEAMS_AUTH=interactive | client-credentials | token

# Entra (Azure AD) app (client) id. For interactive browser sign-in, register a
# PUBLIC client application with the redirect URI http://localhost.
TEAMS_CLIENT_ID=
# Directory tenant: a tenant id, or common | organizations | consumers (default common).
TEAMS_TENANT_ID=common

# --- App-only (automation) --------------------------------------------------
# Set a client secret to use client-credentials (app-only) auth instead of a browser.
# Note: several Teams message APIs need Microsoft's protected-API approval for app-only tokens.
TEAMS_CLIENT_SECRET=

# --- Static token (alternative) ---------------------------------------------
# A pre-obtained Microsoft Graph bearer token. Simplest, but you manage its lifetime.
TEAMS_TOKEN=

# --- Interactive login tuning (optional) ------------------------------------
# Delegated scopes requested at sign-in (comma-separated). Defaults cover team/channel/chat read+post.
TEAMS_SCOPES=offline_access,User.Read,Team.ReadBasic.All,Channel.ReadBasic.All,ChannelMessage.Read.All,ChannelMessage.Send,Chat.ReadWrite
# Where the cached access/refresh token is stored. Default: ~/.mcp-teams/token.json
TEAMS_TOKEN_CACHE=
# Fixed loopback port for the sign-in redirect, or 0 to pick a free one.
TEAMS_REDIRECT_PORT=0

# --- Connection -------------------------------------------------------------
# Microsoft Graph base URL and OAuth authority (rarely changed; e.g. sovereign clouds).
TEAMS_GRAPH_BASE=https://graph.microsoft.com/v1.0
TEAMS_AUTHORITY=https://login.microsoftonline.com
# Request timeout in milliseconds.
TEAMS_TIMEOUT_MS=30000
# Max messages/items returned per list (1-200).
TEAMS_MAX_RESULTS=25

# --- Security flags ---------------------------------------------------------
# Access mode: read-only | read-write | admin. Start with read-only.
#   read-only  -> read tools (whoami, list_teams, list_channels, list_team_members,
#                 list_channel_messages, get_channel_message, list_message_replies,
#                 list_chats, list_chat_messages)
#   read-write -> adds send_channel_message, reply_channel_message, send_chat_message
#   admin      -> adds delete_channel_message (needs TEAMS_ALLOW_DELETE=true)
TEAMS_MODE=read-only
# Posting messages (channel/chat send & reply) requires this in addition to read-write mode.
TEAMS_ALLOW_SEND=false
# Comma-separated team allowlist (team id). Empty = all. Posts/moderation only.
TEAMS_TEAM_ALLOWLIST=
# Teams that can be read but never posted to or moderated (team ids).
TEAMS_PROTECTED_TEAMS=
# Destructive ops (delete_channel_message) require this in addition to admin mode.
TEAMS_ALLOW_DELETE=false
# Validate + log writes without executing them.
TEAMS_DRY_RUN=false
# Emit a JSON audit line to stderr per guarded operation.
TEAMS_AUDIT_LOG=true

# --- AI risk guard (optional; needs a running laya-guard daemon) -------------
# High-risk ops ask a LOCAL laya-guard daemon to classify them allow / confirm / block. Runs AFTER
# the deterministic gates; only tightens, never grants; fails closed.  off | monitor | enforce
TEAMS_GUARD_MODE=off
TEAMS_GUARD_URL=http://127.0.0.1:8799
TEAMS_GUARD_TIMEOUT_MS=2000
TEAMS_GUARD_FAIL_CLOSED=confirm
